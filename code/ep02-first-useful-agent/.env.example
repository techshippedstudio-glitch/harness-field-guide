# Copy to .env and fill in. No keys: sign in with `az login` (Microsoft Entra ID).
# Project endpoint: Foundry portal > your project > Home ("Project endpoint").
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
# Name of a deployed model that supports reasoning and tool calling (Build > Models).
MODEL_DEPLOYMENT=gpt-5.4-mini
AGENT_NAME=fact-checker
